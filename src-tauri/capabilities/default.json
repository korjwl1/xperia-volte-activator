{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "dialog:allow-open",
    "notification:default",
    "core:window:allow-request-user-attention",
    "core:window:allow-destroy"
  ]
}
